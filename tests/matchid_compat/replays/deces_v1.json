    {
      "name": "adv_nom_prenoms_date",
      "category": "advanced_ui",
      "request": {
        "method": "POST",
        "path": "/deces/_search",
        "body": {
          "query": {
            "bool": {
              "must": [
                { "match": { "NOM": "DUPONT" } },
                { "match": { "PRENOMS": "JEANNE" } },
                { "term": { "DATE_NAISSANCE": "19410813" } }
              ]
            }
          },
          "size": 5
        }
      },
      "expected": {
        "hits.total.value": 1,
        "hits.hits[0]._id": "deces_00001"
      }
    },
