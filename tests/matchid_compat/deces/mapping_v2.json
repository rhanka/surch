{
  "settings": {
    "analysis": {
      "tokenizer": {
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": ["letter", "digit"]
        }
      },
      "analyzer": {
        "norm": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "autocomplete_analyzer": {
          "tokenizer": "edge_ngram_tokenizer",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "normalizer": {
        "norm": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "NOM": {
        "type": "text",
        "analyzer": "norm",
        "fields": {
          "raw": { "type": "keyword", "normalizer": "norm" },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "PRENOMS": {
        "type": "text",
        "analyzer": "norm",
        "fields": {
          "raw": { "type": "keyword", "normalizer": "norm" },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "SEXE": { "type": "keyword" },
      "DATE_NAISSANCE": { "type": "keyword" },
      "COMMUNE_NAISSANCE": { "type": "keyword" },
      "CODE_INSEE_NAISSANCE": { "type": "keyword" },
      "DATE_DECES": { "type": "keyword" },
      "COMMUNE_DECES": { "type": "keyword" },
      "SOURCE": { "type": "keyword" },
      "SOURCE_LINE": { "type": "integer" }
    }
  }
}
