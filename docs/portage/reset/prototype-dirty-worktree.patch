+    fn remove_existing_document(&self, external_doc_id: &str) -> Result<bool, Error> {
+        let mut removed = false;
+
+        let mut segment_paths: Vec<PathBuf> = std::fs::read_dir(&self.path)?
+            .filter_map(Result::ok)
+            .map(|entry| entry.path())
+            .filter(|path| {
+                path.file_name()
+                    .and_then(|name| name.to_str())
+                    .map(|name| name.ends_with(SEGMENT_FILE_SUFFIX))
+                    .unwrap_or(false)
+            })
+            .collect();
+
+        segment_paths.sort();
+
+        for segment_path in segment_paths {
+            let mut segment = Segment::load(&segment_path)?;
+            if segment.remove_document(external_doc_id) {
+                segment.persist()?;
+                removed = true;
+            }
+        }
+
+        Ok(removed)
